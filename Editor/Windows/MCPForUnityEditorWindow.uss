/* Forge MCP's page is the Forge Welcome contract (Editor/Welcome): the card, the buttons and the bars that fold are
   its own. This sheet styles what the MCP parts hold so they read as the rest of the page: no card inside a card,
   rows indented as the page's are, buttons as small as Unity's and never the width of the window, colour kept for
   the state dots. Rules start with .forge-mcp (the page's root) so they win over Common.uss, which every part's
   UXML also loads. */

/* ---- Update notice ---------------------------------------------------------------------------------------- */
.update-notification {
    display: none;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    padding: 6px 12px;
    margin-bottom: 6px;
    background-color: rgba(100, 200, 100, 0.15);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(100, 200, 100, 0.3);
}

.update-notification.visible {
    display: flex;
}

.update-notification-text {
    font-size: 11px;
    color: rgba(100, 200, 100, 1);
    white-space: normal;
    flex-shrink: 1;
    -unity-text-align: middle-center;
}

/* ---- What the parts hold ---------------------------------------------------------------------------------- */
.forge-mcp .forge-part {
    padding: 2px 6px 4px 14px;
}

/* A part's groups (Server, Clients, Validation...): a small heading and rows, no box round them. */
.forge-mcp .section {
    margin: 0px 0px 10px 0px;
    padding: 0px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0px;
}

.forge-mcp .section-title {
    font-size: 12px;
    margin: 0px 0px 4px 0px;
    padding: 0px;
    border-bottom-width: 0px;
    letter-spacing: 0px;
}

.forge-mcp .section-content {
    padding: 0px 0px 0px 2px;
}

.forge-mcp .setting-row {
    min-height: 20px;
    margin-bottom: 2px;
}

.forge-mcp .setting-label {
    min-width: 96px;
    color: rgba(255, 255, 255, 0.7);
}

/* Buttons: Unity's own, small; colour only says a state (the server running). */
.forge-mcp .action-button,
.forge-mcp .secondary-button,
.forge-mcp .primary-button {
    width: auto;
    min-width: 64px;
    height: 20px;
    margin: 1px 0px 1px 6px;
    padding: 0px 10px;
    font-size: 12px;
    -unity-font-style: normal;
    letter-spacing: 0px;
    border-radius: 3px;
    border-width: 1px;
    color: rgba(238, 238, 238, 1);
    background-color: rgba(88, 88, 88, 1);
    border-color: rgba(36, 36, 36, 1);
}

.forge-mcp .action-button:hover,
.forge-mcp .secondary-button:hover,
.forge-mcp .primary-button:hover {
    background-color: rgba(103, 103, 103, 1);
}

.forge-mcp .action-button:active,
.forge-mcp .secondary-button:active,
.forge-mcp .primary-button:active {
    background-color: rgba(70, 96, 124, 1);
}

/* Configure all is the page's own Connect clients button: not shown twice. */
.forge-mcp #configure-all-button {
    display: none;
}

/* The server running: its Stop button tinted, not a red block. */
.forge-mcp .action-button.server-running {
    background-color: rgba(120, 66, 60, 1);
    border-color: rgba(70, 30, 26, 1);
}

.forge-mcp .action-button.server-running:hover {
    background-color: rgba(140, 78, 70, 1);
}

.forge-mcp .status-text {
    font-size: 12px;
}

.forge-mcp .client-details-foldout > .unity-foldout__toggle,
.forge-mcp .manual-config-foldout > .unity-foldout__toggle,
.forge-mcp .manual-command-foldout > .unity-foldout__toggle {
    background-color: rgba(0, 0, 0, 0);
    margin-left: -2px;
    -unity-font-style: normal;
}

.forge-mcp .client-details-foldout > .unity-foldout__content {
    margin-left: 0px;
    padding-left: 0px;
}

.forge-mcp .manual-config-content {
    background-color: rgba(0, 0, 0, 0.12);
    border-radius: 3px;
}

/* A part with one group: its heading is the bar's already (Tools under Tools). */
.forge-mcp #tools-container .section-title,
.forge-mcp #resources-container .section-title,
.forge-mcp #assetgen-container .section-title {
    display: none;
}

/* Enable all, Disable all, Rescan...: small buttons in a row that wraps, not a grid of wide ones. */
.forge-mcp .tool-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px 0px 6px 0px;
}

.forge-mcp .tool-actions > * {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 0;
}

.forge-mcp .tool-action-button {
    flex-grow: 0;
    flex-basis: auto;
    height: 20px;
    margin: 1px 4px 1px 0px;
    padding: 0px 10px;
    font-size: 12px;
}

/* ---- Light skin ------------------------------------------------------------------------------------------- */
.unity-theme-light .update-notification {
    background-color: rgba(100, 200, 100, 0.1);
    border-color: rgba(100, 200, 100, 0.25);
}

.unity-theme-dark .update-notification-text {
    color: rgba(150, 255, 150, 1);
}

.unity-theme-light .forge-mcp .setting-label {
    color: rgba(0, 0, 0, 0.7);
}

.unity-theme-light .forge-mcp .action-button,
.unity-theme-light .forge-mcp .secondary-button,
.unity-theme-light .forge-mcp .primary-button {
    color: rgba(9, 9, 9, 1);
    background-color: rgba(228, 228, 228, 1);
    border-color: rgba(178, 178, 178, 1);
}

.unity-theme-light .forge-mcp .action-button:hover,
.unity-theme-light .forge-mcp .secondary-button:hover,
.unity-theme-light .forge-mcp .primary-button:hover {
    background-color: rgba(236, 236, 236, 1);
}

.unity-theme-light .forge-mcp .action-button.server-running {
    background-color: rgba(232, 196, 190, 1);
    border-color: rgba(190, 140, 132, 1);
}
